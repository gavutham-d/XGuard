# XGuard Environment Configuration
# Copy this file to .env to configure custom API keys or backend ports

APP_NAME="XGuard Backend"
APP_VERSION="1.0.0"
DEBUG=false
HOST="127.0.0.1"
PORT=8000

# Database
DATABASE_URL="sqlite:///./threatguard.db"

# Scanning Policy
DEFAULT_PROTECTION_MODE="balanced"
SCAN_TIMEOUT_SECONDS=3.0
MAX_REDIRECT_HOPS=5

# Threat Intelligence Feeds
URLHAUS_API_ENABLED=true
URLHAUS_TIMEOUT_SECONDS=2.0

# Optional External AI Assistant LLM Provider (Groq / OpenAI)
# If omitted, XGuard Assistant uses its built-in cybersecurity expert engine
GROQ_API_KEY=""
OPENAI_API_KEY=""
LLM_MODEL="llama-3.1-8b-instant"
