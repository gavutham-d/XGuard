{
  "manifest_version": 3,
  "name": "XGuard: Real-Time Link & Phishing Protection",
  "version": "1.0.0",
  "description": "Real-time AI-powered link scanner that intercepts clicks, detects phishing, typosquatting & malware, provides safe interstitial warnings, and offers an AI cybersecurity assistant.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "XGuard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/page_signals.js", "src/content/link_interceptor.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "sidePanel",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/warning/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
